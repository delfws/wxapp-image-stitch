page {
  /* 继承 app.wxss 的光晕背景，本页不再覆盖 */
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 60rpx;
}

.hero-badge {
  width: 168rpx;
  height: 168rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 92rpx;
  /* 强玻璃：釉面渐变 + 双内描边 */
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.25) 55%, rgba(255, 255, 255, 0.65) 100%),
    rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(48rpx) saturate(220%);
  -webkit-backdrop-filter: blur(48rpx) saturate(220%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 24rpx 60rpx rgba(91, 140, 255, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 1),
    inset 0 -2rpx 0 rgba(255, 255, 255, 0.3),
    inset 0 -3rpx 8rpx rgba(31, 38, 135, 0.06);
  overflow: hidden;
}

/* Logo 图标（铺满玻璃徽章容器） */
.hero-logo {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-title {
  margin-top: 44rpx;
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  background: linear-gradient(135deg, #4a6cf7, #8a6cff);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-sub {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #5a607a;
}

/* 玻璃步骤卡片 */
.steps {
  margin: 40rpx 40rpx 0;
  border-radius: 36rpx;
  padding: 12rpx 40rpx;
  /* 标准玻璃：釉面渐变 + 双内描边 */
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.2) 40%, rgba(255, 255, 255, 0.12) 62%, rgba(255, 255, 255, 0.48) 100%),
    rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(44rpx) saturate(220%);
  -webkit-backdrop-filter: blur(44rpx) saturate(220%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 16rpx 48rpx rgba(31, 38, 135, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.3),
    inset 0 -2rpx 6rpx rgba(31, 38, 135, 0.05);
}

.step {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.step + .step {
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
}

.step-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  flex-shrink: 0;
  /* 轻玻璃图标 */
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.2) 55%, rgba(255, 255, 255, 0.55) 100%),
    rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}

.step-body {
  margin-left: 30rpx;
}

.step-title {
  font-size: 31rpx;
  font-weight: 600;
}

.step-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6a708a;
}

.start-area {
  padding: 80rpx 56rpx 0;
}

.start-btn {
  width: 100%;
}
