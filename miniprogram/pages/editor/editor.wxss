/* 页面不锁定高度，内容超出时整页自然滚动 */

.editor {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* 透明，透出 app.wxss 的光晕背景 */
  background: transparent;
  padding: 0 20rpx;
  /* 底部避让 Home 指示条（安全区），并给工具栏留出收尾间距 */
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 固定顶部导航（玻璃表面，内容从其下方滚过） ===== */
.editor-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 0 20rpx 10px;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.2) 40%, rgba(255, 255, 255, 0.12) 62%, rgba(255, 255, 255, 0.45) 100%),
    rgba(245, 247, 255, 0.4);
  backdrop-filter: blur(44rpx) saturate(220%);
  -webkit-backdrop-filter: blur(44rpx) saturate(220%);
  box-shadow:
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.6),
    inset 0 -2rpx 6rpx rgba(31, 38, 135, 0.06);
}

/* 固定导航的占位（等高于状态栏留白 + 导航条） */
.header-placeholder {
  flex-shrink: 0;
}

/* ===== 顶部导航条（与系统胶囊同高对齐） ===== */
.topbar-spacer {
  /* 透明，占位到系统胶囊 top */
}

.topbar {
  position: relative;
  display: flex;
  align-items: center;
}

.topbar-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.25) 55%, rgba(255, 255, 255, 0.6) 100%),
    rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 6rpx 20rpx rgba(31, 38, 135, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.3);
}

/* CSS 边框箭头：旋转方块，几何居中，不依赖字形 */
.topbar-back::after {
  content: "";
  width: 20rpx;
  height: 20rpx;
  border-top: 5rpx solid #4a6cf7;
  border-left: 5rpx solid #4a6cf7;
  transform: rotate(-45deg);
  margin-left: 6rpx; /* 旋转后视觉重心右偏，左移补偿使箭头居中 */
}

.topbar-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 2rpx;
  pointer-events: none;
}

/* ===== 操作导航（浮动玻璃胶囊） ===== */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  margin-top: 28rpx;
  border-radius: 40rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.22) 40%, rgba(255, 255, 255, 0.14) 62%, rgba(255, 255, 255, 0.5) 100%),
    rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(44rpx) saturate(220%);
  -webkit-backdrop-filter: blur(44rpx) saturate(220%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 14rpx 40rpx rgba(31, 38, 135, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.3),
    inset 0 -2rpx 6rpx rgba(31, 38, 135, 0.06);
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.nav-btn {
  font-size: 26rpx;
  color: #4a6cf7;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.2) 55%, rgba(255, 255, 255, 0.5) 100%),
    rgba(255, 255, 255, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}

.nav-primary {
  color: #ffffff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 50%),
    linear-gradient(135deg, #5b8cff, #8a6cff);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  font-weight: 600;
  box-shadow:
    0 6rpx 20rpx rgba(91, 140, 255, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.65);
}

/* ===== 空态 ===== */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 100rpx;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6a708a;
  text-align: center;
}

.empty-btn {
  margin-top: 60rpx;
  width: 100%;
}

/* ===== 画布区（自然文档流，随内容撑开、整页滚动） ===== */
.canvas-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.canvas-box {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  /* 漂浮感投影 + 高光描边 */
  box-shadow:
    0 24rpx 60rpx rgba(31, 38, 135, 0.22),
    0 0 0 1rpx rgba(255, 255, 255, 0.55),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.canvas-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6a708a;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0.12) 45%, rgba(255, 255, 255, 0.4) 100%),
    rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20rpx) saturate(180%);
  -webkit-backdrop-filter: blur(20rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.2);
}

/* 图片格 */
.cell {
  position: absolute;
  overflow: hidden;
}

.cell-pan-img {
  position: absolute;
  display: block;
}

/* 拖拽浮层内层图 */
.cell-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cell-src .cell-img {
  opacity: 0.3;
}

.cell-hit {
  box-shadow: inset 0 0 0 4rpx #5b8cff;
  border-radius: 6rpx;
  z-index: 2;
}

/* 分割线：默认隐藏，拖动时显示 */
.divider-hit {
  position: absolute;
  z-index: 5;
}

.divider-line {
  position: absolute;
  background: linear-gradient(180deg, #7ba6ff, #4a6cf7);
  border-radius: 4rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease;
  box-shadow: 0 0 12rpx rgba(91, 140, 255, 0.6);
}

.line-show {
  opacity: 0.95;
}

/* 拖拽浮层 */
.float-img {
  position: fixed;
  z-index: 999;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow:
    0 24rpx 56rpx rgba(31, 38, 135, 0.4),
    0 0 0 1rpx rgba(255, 255, 255, 0.5);
  transform: scale(1.06);
  pointer-events: none;
  transition: opacity 0.18s ease;
}

.float-fade {
  opacity: 0;
}

/* ===== 编辑模式切换 ===== */
.mode-row {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx 4rpx;
}

.mode-chip {
  font-size: 26rpx;
  color: #5a6070;
  padding: 12rpx 30rpx;
  border-radius: 32rpx;
  margin-right: 16rpx;
  /* 轻玻璃 */
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.15) 45%, rgba(255, 255, 255, 0.45) 100%),
    rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}

.mode-on {
  color: #ffffff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 50%),
    linear-gradient(135deg, #5b8cff, #8a6cff);
  border-color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
  box-shadow:
    0 6rpx 18rpx rgba(91, 140, 255, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.65);
}

.mode-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #6a708a;
}

/* ===== 拼接方式切换（模板/简单） ===== */
.style-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.style-chip {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #5a6070;
  padding: 14rpx 0;
  border-radius: 32rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.15) 45%, rgba(255, 255, 255, 0.45) 100%),
    rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}

.style-chip.style-on {
  background: linear-gradient(135deg, #5b8cff, #8a6cff);
  color: #ffffff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 255, 0.4);
}

/* ===== 简单拼接方向卡片 ===== */
.dir-row {
  display: flex;
  gap: 20rpx;
}

.dir-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0.48) 100%),
    rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  color: #3a4056;
  font-weight: 600;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}

.dir-card.dir-on {
  border-color: #5b8cff;
  background: rgba(91, 140, 255, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 255, 0.25);
}

.dir-sub {
  font-size: 20rpx;
  color: #8a90a8;
  font-weight: 400;
  margin-top: 4rpx;
}

.dir-demo {
  display: flex;
  gap: 8rpx;
  width: 160rpx;
  height: 120rpx;
  margin-bottom: 14rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: rgba(122, 130, 160, 0.15);
}

.dir-demo-col {
  flex-direction: column;
}

.dir-cell {
  background: rgba(122, 130, 160, 0.45);
  border-radius: 6rpx;
  height: 100%;
}

.dir-demo-col .dir-cell {
  width: 100%;
  height: auto;
}

/* ===== 外框比例 ===== */
.aspect-row {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx 4rpx;
}

.aspect-label {
  font-size: 24rpx;
  color: #6a708a;
  margin-right: 20rpx;
}

.aspect-chip {
  font-size: 24rpx;
  color: #5a6070;
  padding: 12rpx 30rpx;
  border-radius: 32rpx;
  margin-right: 18rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.15) 45%, rgba(255, 255, 255, 0.45) 100%),
    rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}

.chip-active {
  color: #ffffff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 50%),
    linear-gradient(135deg, #5b8cff, #8a6cff);
  border-color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
  box-shadow:
    0 6rpx 18rpx rgba(91, 140, 255, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.65);
}

/* ===== 底部工具栏（浮动玻璃面板） ===== */
.toolbar {
  margin-top: 8rpx;
  margin-bottom: 12rpx;
  border-radius: 36rpx;
  padding: 8rpx 24rpx 16rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.25) 40%, rgba(255, 255, 255, 0.16) 62%, rgba(255, 255, 255, 0.52) 100%),
    rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(48rpx) saturate(220%);
  -webkit-backdrop-filter: blur(48rpx) saturate(220%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 18rpx 52rpx rgba(31, 38, 135, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.32),
    inset 0 -2rpx 8rpx rgba(31, 38, 135, 0.06);
}

.tab-row {
  display: flex;
  justify-content: center;
}

.tab {
  font-size: 28rpx;
  color: #6a708a;
  padding: 14rpx 44rpx;
  position: relative;
}

.tab-active {
  color: #4a6cf7;
  font-weight: 600;
}

.tab-active::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 4rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #5b8cff, #8a6cff);
}

.panel {
  box-sizing: border-box;
  padding-top: 8rpx;
  /* 高度自适应：布局/方向面板内容较多时撑开，超出由外层滚动区承接 */
}

.panel-row {
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx 0;
}

.panel-label {
  font-size: 24rpx;
  color: #6a708a;
  width: 80rpx;
  flex-shrink: 0;
}

.panel-value {
  font-size: 24rpx;
  color: #4a6cf7;
  width: 90rpx;
  text-align: right;
  flex-shrink: 0;
}

.gap-slider {
  flex: 1;
  margin: 0 10rpx;
}

.palette-wrap {
  flex: 1;
  overflow: hidden;
}

/* 图片管理面板（父级高度已改为自适应，此处固定高度以稳定横向滚动区域） */
.img-panel-scroll {
  width: 100%;
  height: 152rpx;
  box-sizing: border-box;
}

.img-panel-row {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 8rpx;
}

.img-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow:
    0 6rpx 18rpx rgba(31, 38, 135, 0.15),
    0 0 0 1rpx rgba(255, 255, 255, 0.55);
}

.img-thumb image {
  width: 100%;
  height: 100%;
}

.img-thumb-del {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(28, 30, 40, 0.55);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 16rpx;
}

.img-add {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0.2) 55%, rgba(255, 255, 255, 0.5) 100%),
    rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(24rpx) saturate(200%);
  -webkit-backdrop-filter: blur(24rpx) saturate(200%);
  border: 1rpx dashed rgba(91, 140, 255, 0.6);
  color: #4a6cf7;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}
