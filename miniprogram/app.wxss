page {
  /* 液态玻璃背景：高饱和径向光晕（色彩斑点）+ 渐变底，玻璃面模糊后透出明显色彩 */
  background:
    radial-gradient(circle at 12% 18%, rgba(99, 140, 255, 0.55), transparent 44%),
    radial-gradient(circle at 88% 10%, rgba(255, 130, 200, 0.5), transparent 42%),
    radial-gradient(circle at 82% 88%, rgba(110, 220, 200, 0.48), transparent 48%),
    radial-gradient(circle at 18% 86%, rgba(180, 140, 255, 0.45), transparent 46%),
    radial-gradient(circle at 50% 45%, rgba(255, 218, 150, 0.22), transparent 32%),
    linear-gradient(160deg, #e8edff 0%, #f7e9f4 52%, #e4f4ff 100%);
  background-attachment: fixed;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #1a1a2e;
  -webkit-font-smoothing: antialiased;
}

/* ========== 液态玻璃表面 ==========
   配方：斜向光泽渐变（左上高光→中部透→右下回弹）+ 彩色底
   + 模糊提饱和 + 顶亮/底暗双内描边（模拟玻璃厚度折射） */

/* 标准玻璃 */
.glass {
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0.12) 38%, rgba(255, 255, 255, 0.05) 60%, rgba(255, 255, 255, 0.35) 100%),
    rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(32rpx) saturate(200%);
  -webkit-backdrop-filter: blur(32rpx) saturate(200%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 10rpx 32rpx rgba(31, 38, 135, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25),
    inset 0 -1rpx 4rpx rgba(31, 38, 135, 0.05);
}

/* 强玻璃：更亮更浮（导航/工具栏/大卡片） */
.glass-strong {
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.2) 40%, rgba(255, 255, 255, 0.12) 62%, rgba(255, 255, 255, 0.48) 100%),
    rgba(255, 255, 255, 0.34);
  backdrop-filter: blur(44rpx) saturate(220%);
  -webkit-backdrop-filter: blur(44rpx) saturate(220%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 16rpx 48rpx rgba(31, 38, 135, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 1),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.3),
    inset 0 -2rpx 6rpx rgba(31, 38, 135, 0.06);
}

/* 轻玻璃：次要控件 */
.glass-subtle {
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.1) 45%, rgba(255, 255, 255, 0.28) 100%),
    rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.2);
}

/* 深色玻璃：用于深色场景（预览页） */
.glass-dark {
  background: rgba(28, 30, 40, 0.42);
  backdrop-filter: blur(30rpx) saturate(160%);
  -webkit-backdrop-filter: blur(30rpx) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}

/* ========== 按钮 ========== */

/* 主按钮：渐变填充 + 顶部釉面高光 + 镜面内描边 */
.btn-primary {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 45%),
    linear-gradient(135deg, #5b8cff 0%, #8a6cff 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow:
    0 12rpx 32rpx rgba(91, 140, 255, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.65),
    inset 0 -2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* 次按钮：玻璃胶囊 */
.btn-ghost {
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.15) 45%, rgba(255, 255, 255, 0.35) 100%),
    rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  color: #4a6cf7;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(255, 255, 255, 0.25);
}
