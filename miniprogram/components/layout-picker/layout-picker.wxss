.picker-scroll {
  width: 100%;
  white-space: nowrap;
}

.picker-row {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 8rpx;
}

.thumb {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  padding: 10rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.3);
}

.thumb-active {
  border-color: rgba(91, 140, 255, 0.8);
  background: rgba(91, 140, 255, 0.18);
  box-shadow: 0 4rpx 16rpx rgba(91, 140, 255, 0.3);
}

.thumb-canvas {
  position: relative;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  overflow: hidden;
}

.thumb-cell {
  position: absolute;
  background: rgba(120, 140, 180, 0.55);
  border-radius: 2rpx;
}

.thumb-active .thumb-cell {
  background: linear-gradient(135deg, #5b8cff, #8a6cff);
}

.thumb-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6a708a;
}

.thumb-active .thumb-name {
  color: #4a6cf7;
  font-weight: 600;
}
