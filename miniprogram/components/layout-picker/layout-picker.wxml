<scroll-view class="picker-scroll" scroll-x enhanced show-scrollbar="{{false}}">
  <view class="picker-row">
    <view
      wx:for="{{thumbs}}"
      wx:key="name"
      class="thumb {{current === index ? 'thumb-active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <view class="thumb-canvas" style="width:{{item.w}}px;height:{{item.h}}px;">
        <view
          wx:for="{{item.cells}}"
          wx:for-item="cell"
          wx:for-index="ci"
          wx:key="ci"
          class="thumb-cell"
          style="left:{{cell.left}}px;top:{{cell.top}}px;width:{{cell.width}}px;height:{{cell.height}}px;"
        ></view>
      </view>
      <view class="thumb-name">{{item.name}}</view>
    </view>
  </view>
</scroll-view>
